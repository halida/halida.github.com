# 私密配置模板：复制为 .env 后填入真实值。
# .env 已被 .gitignore 排除，不会进入仓库。
#
#   cp .env.example .env

# Disqus 后台 → Settings → API → Public Key
# 用途：导出旧评论、列出历史线程（scripts/disqus-threads.mjs）
DISQUS_API_KEY=

# GitHub classic personal access token，勾选 repo 权限
# 用途：写入 GitHub Discussions（scripts/migrate-disqus-to-giscus.mjs）
GITHUB_TOKEN=

# giscus.app 生成的 <script> 里的两个 id
# 用途：构建时注入评论区；缺少时评论区自动不渲染
GISCUS_REPO_ID=
GISCUS_CATEGORY_ID=

# strict 模式：1 = 只有已存在的 Discussion 才能评论（需先迁移旧评论）
GISCUS_STRICT=0
